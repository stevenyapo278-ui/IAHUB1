# =============================================================================
# IA Hub — Helpdesk ITSM Automation
# Copiez ce fichier vers .env et remplissez les valeurs requises
# =============================================================================

# ── Base de données PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql://erp_user:erp_password@localhost:5432/erp_itsm?schema=public

# ── Authentification JWT ───────────────────────────────────────────────────
JWT_SECRET=mon_secret_jwt_tres_long_et_aleatoire
JWT_EXPIRES_IN=8h

# ── URLs du service ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4000
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=*
PORT=4000

# ── TLS (facultatif) — si les fichiers existent, le serveur écoute en HTTPS sur PORT ──
# Générer les certificats avec ./scripts/generate-tls.sh (voir .gitignore, pas de commit)
TLS_CERT_PATH=/app/certs/server.crt
TLS_KEY_PATH=/app/certs/server.key

# ── GLPI (ITSM) ────────────────────────────────────────────────────────────
# Configuré via l'interface Paramètres > Autres intégrations
GLPI_URL=http://glpi/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# ── Microsoft / Outlook OAuth ──────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/oauth/outlook/callback

# ── LDAP / Active Directory (connexion des comptes AD — fallback après l'auth locale) ──
# Permet la connexion avec l'identifiant seul (ex. « styapo ») au lieu de l'adresse complète
# (ex. « styapo@prosuma.ci »). Vide = désactivé.
AUTH_EMAIL_DOMAIN=
LDAP_ENABLED=false
LDAP_URL=ldap://10.0.70.1
LDAP_EMAIL_DOMAIN=prosuma.ci
# Format du bind : {username}@{domain} (UPN) ou {domain}\{username} (style NTLM)
LDAP_BIND_FORMAT={username}@{domain}
# Usernames AD DSI/administrateurs, séparés par des virgules -> rôle ADMIN (les autres : REQUESTER)
LDAP_ADMIN_USERNAMES=

# ── Synchro annuaire AD (remplace la vue LDAP de GLPI) ─────────────────────
# Réflète l'AD dans IA Hub toutes les 10 min : crée les nouveaux comptes,
# met à jour le nom complet, désactive les comptes disparus/désactivés de l'AD.
# Bouton manuel : POST /api/users/sync-ldap (admin).
# Nécessite un compte de service AD en lecture seule — réutilise celui de GLPI.
LDAP_DIRECTORY_URL=ldap://prosuma.lan:389
LDAP_BIND_DN=CN=glpi,OU=informatique,OU=centrale,OU=prosuma,DC=prosuma,DC=lan
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=OU=prosuma,DC=prosuma,DC=lan
# Filtre SANS exclusion des comptes désactivés (on veut les voir pour les désactiver ici aussi)
LDAP_USER_FILTER=(&(objectClass=user)(objectCategory=person))

# ── Fournisseurs IA ────────────────────────────────────────────────────────
# Configuré via l'interface Paramètres > IA

# ── Logs ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=erp-backend/logs

# ── n8n (optionnel) ────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=

# ── Paramètres avancés (ne pas modifier sans comprendre) ───────────────────
NODE_ENV=${NODE_ENV:-production}

# ── Configuration de la base GLPI locale (Docker Compose optionnel) ────────
GLPI_DB_HOST=db
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi
