PORT=4000
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/erp_itsm?schema=public"
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN="15m"
AUTH_SESSION_MAX_HOURS="12"
AUTH_IDLE_TIMEOUT_MINUTES="30"
AUTH_MAX_SESSIONS="10"
AUTH_COOKIE_SAMESITE="lax"
# Verrouillage de compte : échecs autorisés sur 15 min avant blocage de 15 min.
AUTH_LOCKOUT_THRESHOLD="10"
# Longueur minimale des mots de passe (aligné avec erp-frontend/src/utils/passwordPolicy.js).
PASSWORD_MIN_LENGTH="12"
# openssl rand -base64 32 — ne jamais committer la vraie valeur
SECRETS_ENCRYPTION_KEY=""
CORS_ORIGIN="*"
MICROSOFT_REDIRECT_URI="http://localhost:4000/api/oauth/outlook/callback"
